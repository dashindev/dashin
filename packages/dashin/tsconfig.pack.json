{
  "extends": "./tsconfig",
  "compilerOptions": {
    "jsx": "react",
    "module": "commonjs",
    "noEmit": false,
    "plugins": [
      {
        "transform": "typescript-transform-paths"
      },
      {
        "transform": "typescript-transform-paths",
        "afterDeclarations": true
      }
    ]
  },
  "include": ["src"],
  "exclude": [
    "index.ts",
    "node_modules",
    "lib",
    "pages",
    "src/.dashin",
    "src/App.spec.tsx",
    "src/App.tsx",
    "src/index.tsx",
    "src/serviceWorker.ts",
    "src/pages/**",
    "src/private/**",
    "src/utils/pluginRegistry.ts",
    "src/setupTests.ts",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
