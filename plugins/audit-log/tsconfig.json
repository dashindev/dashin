{
  "extends": "../../tsconfig",
  "compilerOptions": {
    "jsx": "react",
    "rootDir": "./src",
    "outDir": "./lib",
    "declaration": true,
    "declarationDir": "./lib",
    "baseUrl": "./"
  },
  "exclude": [
    "node_modules",
    "lib",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "include": [
    "src/*.ts",
    "src/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
