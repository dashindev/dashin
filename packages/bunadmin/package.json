{
  "name": "@bunred/bunadmin",
  "version": "1.2.5",
  "description": "A simple graphql admin dashboard. Easy to expand with the flexible plugin. Graphql first, also supports api. Based on React, Redux, Material-UI, Realtime RxDB, Formik, I18N.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bunred/bunadmin"
  },
  "bugs": {
    "url": "https://github.com/bunred/bunadmin/issues"
  },
  "author": "BunRed Team",
  "main": "lib/main.js",
  "types": "lib/main.d.ts",
  "files": [
    "lib",
    "plugin.js"
  ],
  "scripts": {
    "setup": "yarn && yarn build",
    "start": "react-app-rewired start",
    "build": "react-app-rewired build",
    "test": "react-app-rewired test --env=jest-environment-jsdom-sixteen",
    "pretest": "node bunadmin-scripts.js",
    "eject": "react-scripts eject",
    "prettier": "prettier --write  --no-semi src/** pages/** plugins/** test/**",
    "post-update": "echo \"codesandbox preview only, need an update\" && yarn upgrade --latest",
    "ttsc": "rimraf lib & ttsc -p tsconfig.pack.json",
    "ttsc-pack": "rimraf lib & ttsc -p tsconfig.pack.json && npm pack"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "peerDependencies": {
    "@types/react": "17.0.2",
    "@types/react-dom": "17.0.2",
    "react": "17.0.2",
    "react-dom": "17.0.2"
  },
  "dependencies": {
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@material-ui/lab": "^4.0.0-alpha.61",
    "@reduxjs/toolkit": "^1.8.2",
    "babel-loader": "^8.2.5",
    "clsx": "^1.1.1",
    "filehound": "^1.17.6",
    "formik": "^2.2.9",
    "formik-material-ui": "3.0.1",
    "i18next": "^21.8.10",
    "json-bigint": "^1.0.0",
    "material-table": "npm:@bunred/material-table@0.69.0-beta.1",
    "nanoid": "3.3.4",
    "notistack": "^1.0.10",
    "pouchdb-adapter-http": "^7.3.0",
    "pouchdb-adapter-idb": "^7.3.0",
    "pouchdb-adapter-memory": "^7.3.0",
    "prism-react-renderer": "^1.3.3",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-dropzone": "^14.2.1",
    "react-eva-icons": "0.0.8",
    "react-i18next": "^11.17.2",
    "react-redux": "^8.0.2",
    "react-router-dom": "5.3.3",
    "rxdb": "11.6.1",
    "rxjs": "^7.5.5",
    "umi-request": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.11.10",
    "@testing-library/react": "^11.2.6",
    "@types/jest": "^26.0.15",
    "@types/mockjs": "^1.0.6",
    "@types/node": "^14.0.6",
    "@types/react": "17.0.2",
    "@types/react-beautiful-dnd": "^13.1.2",
    "@types/react-dom": "17.0.2",
    "@types/react-redux": "^7.1.24",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-test-renderer": "^18.0.0",
    "husky": "^4.2.5",
    "ignore-loader": "^0.1.2",
    "jest": "^25.5.4",
    "jest-canvas-mock": "^2.3.0",
    "jest-environment-jsdom-sixteen": "^1.0.3",
    "prettier": "1.19.1",
    "pretty-quick": "^2.0.1",
    "react-app-rewire-alias": "^1.1.7",
    "react-app-rewired": "^2.2.1",
    "react-scripts": "4.0.3",
    "react-test-renderer": "^17.0.1",
    "serve-handler": "^6.1.3",
    "ttypescript": "^1.5.13",
    "typescript": "^4.7.4",
    "typescript-transform-paths": "^3.3.1"
  },
  "jest": {
    "moduleNameMapper": {
      "@/(.*)": "<rootDir>/src/$1",
      "@bunred/bunadmin/(.*)": "<rootDir>/src/$1",
      "@.bunadmin/dynamic/(.*)": "<rootDir>/./bunadmin/dynamic/$1"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "keywords": [
    "admin",
    "graphql",
    "react",
    "react admin",
    "material",
    "material admin",
    "plugin",
    "dashboard",
    "admin panel"
  ],
  "homepage": "https://www.bunred.com/",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}