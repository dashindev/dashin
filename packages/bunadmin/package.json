{
  "name": "@xbuilder/bunadmin",
  "version": "1.6.0-beta.0",
  "description": "A simple graphql admin dashboard. Easy to expand with the flexible plugin. Graphql first, also supports api. Based on React, Redux, Tailwind CSS, Headless UI, Formik, I18N.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/xbuilder/bunadmin"
  },
  "bugs": {
    "url": "https://github.com/xbuilder/bunadmin/issues"
  },
  "author": "XBuilder Team",
  "main": "lib/main.js",
  "types": "lib/main.d.ts",
  "files": [
    "lib",
    "plugin.js"
  ],
  "scripts": {
    "setup": "yarn && yarn build",
    "tailwind:build": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.out.css --minify",
    "tailwind:watch": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.out.css --watch",
    "start": "yarn tailwind:build && NODE_OPTIONS=--openssl-legacy-provider react-app-rewired start",
    "build": "yarn tailwind:build && NODE_OPTIONS=--openssl-legacy-provider react-app-rewired build",
    "test": "react-app-rewired test --env=jest-environment-jsdom-sixteen",
    "pretest": "node bunadmin-scripts.js",
    "eject": "react-scripts eject",
    "prettier": "prettier --write  --no-semi src/** pages/** plugins/** test/**",
    "post-update": "echo \"codesandbox preview only, need an update\" && yarn upgrade --latest",
    "tsc:watch": "ttsc -w -p tsconfig.pack.json",
    "tsc:clean": "tsc --build --clean",
    "tsc:build": "ttsc -p tsconfig.pack.json"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "resolutions": {
    "react-error-overlay": "6.0.9"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.19",
    "@reduxjs/toolkit": "1.8.4",
    "@xbuilder/bunadmin-auth-local": "^1.6.0-beta.0",
    "babel-loader": "^8.2.5",
    "clsx": "^1.1.1",
    "del": "^6.1.1",
    "dexie": "^3.2.2",
    "dexie-export-import": "^1.0.3",
    "filehound": "^1.17.6",
    "formik": "^2.4.6",
    "i18next": "^21.8.10",
    "json-bigint": "^1.0.0",
    "nanoid": "3.3.4",
    "notistack": "^3.0.1",
    "prism-react-renderer": "^1.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.1",
    "react-eva-icons": "0.0.8",
    "react-i18next": "^11.17.2",
    "react-redux": "8.0.4",
    "react-router-dom": "^6.23.1",
    "umi-request": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.11.10",
    "@testing-library/react": "^15.0.7",
    "@types/jest": "^26.0.15",
    "@types/mockjs": "^1.0.6",
    "@types/node": "^14.0.6",
    "@types/react": "^18.3.3",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.3.0",
    "@types/react-redux": "^7.1.24",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-test-renderer": "^18.3.0",
    "husky": "^4.2.5",
    "ignore-loader": "^0.1.2",
    "jest": "^25.5.4",
    "jest-canvas-mock": "^2.3.0",
    "jest-environment-jsdom-sixteen": "^1.0.3",
    "prettier": "1.19.1",
    "pretty-quick": "^2.0.1",
    "react-app-rewire-alias": "^1.1.7",
    "react-app-rewired": "^2.2.1",
    "react-error-overlay": "6.0.9",
    "react-scripts": "4.0.3",
    "react-test-renderer": "^17.0.1",
    "serve-handler": "^6.1.3",
    "tailwindcss": "^3.4.4",
    "ttypescript": "^1.5.13",
    "typescript": "4.8.3",
    "typescript-transform-paths": "^3.3.1"
  },
  "jest": {
    "moduleNameMapper": {
      "@/(.*)": "<rootDir>/src/$1",
      "@xbuilder/bunadmin/(.*)": "<rootDir>/src/$1",
      "@.bunadmin/dynamic/(.*)": "<rootDir>/./bunadmin/dynamic/$1"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "keywords": [
    "admin",
    "graphql",
    "react",
    "react admin",
    "tailwind",
    "tailwind admin",
    "plugin",
    "dashboard",
    "admin panel"
  ],
  "homepage": "https://www.xbuilder.net/",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
